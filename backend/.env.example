# MediKiosk API Configuration Example
# Do not commit real secrets to source control.

PROJECT_NAME="MediKiosk API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/medikiosk"

# CORS
# Comma-separated list or JSON array string format
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'

# LLM Provider Configuration
# Options: 'gemini' | 'mock'
LLM_PROVIDER="mock"
GEMINI_API_KEY="your-gemini-api-key-here"

# OCR Provider Configuration
# Options: 'tesseract' | 'mock'
OCR_PROVIDER="mock"

# Speech Provider Configuration
# Options: 'webspeech' | 'mock'
SPEECH_PROVIDER="mock"

# Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage"

# MOCK Integration Toggles (Keep True for development)
ABDM_MOCK_MODE=True
FHIR_MOCK_MODE=True
